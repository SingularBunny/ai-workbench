# Template for ~/.openclaw/.env — OpenClaw reads this file itself (docs/gateway/config-secrets-env.md).
# The installer creates it with the Gateway token; keys are added by hand. Never goes into git.

# ## Gateway
# Created by the installer if missing: Gateway login token (Control UI, TUI).
OPENCLAW_GATEWAY_TOKEN=

# ## Model keys
# OpenRouter key: many models through one key. At least one model key is needed, or a Claude
# subscription through the Claude CLI (WORKBENCH_DEFAULT_RUNTIME).
OPENROUTER_API_KEY=

# Key from the Anthropic Console.
ANTHROPIC_API_KEY=

# ## Models
# Default model; empty means openrouter/auto.
WORKBENCH_DEFAULT_MODEL=

# Comma-separated fallback models — used when the primary one fails (subscription limits, network).
WORKBENCH_FALLBACK_MODELS=

# Default model runtime: claude-cli — through Claude Code and its login (Claude subscription),
# with WORKBENCH_DEFAULT_MODEL=anthropic/claude-opus-5-5. Requires `claude` installed and logged in.
WORKBENCH_DEFAULT_RUNTIME=

# Dreaming model — the nightly move of notes into MEMORY.md; empty means the agent's model. A light
# model saves limits: anthropic/claude-haiku-5-5 (with WORKBENCH_DEFAULT_RUNTIME — via the same Claude CLI).
WORKBENCH_DREAMING_MODEL=

# Semantic memory search with a local embedding model (llama-cpp plugin): cpu, or vulkan for the
# GPU (picks a discrete NVIDIA card by itself; vulkan:<index from vulkaninfo> — explicitly). The
# one-time server setup is interactive: openclaw models auth login --provider llama-cpp --method local.
WORKBENCH_LOCAL_EMBEDDINGS=

# Ollama, local or on a VM via `ssh -L 11434:127.0.0.1:11434 <vm>`; without /v1.
WORKBENCH_OLLAMA_URL=

# ## Profile and plugins
# Personal profile: a folder with profile.mjs — your own plugins, skills, MCP, tasks. Empty — public build.
WORKBENCH_PROFILE=

# Where your own plugins are cloned; default ~/.local/share/ai-workbench/plugins.
WORKBENCH_PLUGINS_ROOT=

# Grafana MCP (if the profile defines it): installed only when the URL is set. A token, or login and password.
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# ## Knowledge base
# Knowledge base folders for every agent, separated by ":" (an Obsidian vault is one; docs/features/knowledge.md):
# agents search the Markdown notes there with memory search and may save notes there. Per project: "knowledge"
# in project.json. Not / or the home folder itself.
WORKBENCH_KNOWLEDGE=

# ## Chat
# MCP Apps: interactive views from MCP servers in the chat (a sandbox on the Gateway port + 1, 18790
# by default). 1 — enable, 0 — disable, empty — leave as is. Enable only for MCP servers you trust:
# the view HTML comes from the server. Restart the Gateway after the change.
WORKBENCH_MCP_APPS=

# Chat file folders (docs/features/chat-files.md, needs the fork): folders, separated by ":", whose files the
# chat opens and downloads whatever their type, for all agents (e.g. ~/Desktop:~/Downloads). Per project:
# "chatFileFolders" in project.json. Not / or the home folder itself. Empty: the setting is not touched.
WORKBENCH_CHAT_FILE_FOLDERS=

# OpenClaw Chrome extension: the installer registers a native host through which the extension
# finds the local OpenClaw (if Chrome or Chromium has been launched before). 0 — do not register.
WORKBENCH_CHROME_EXTENSION=

# Claude in Chrome for agents on Claude CLI (OpenClaw from the fork): 1 — agents can drive Chrome through the
# Claude in Chrome extension, as Claude Code does. Browser control, so off unless set.
WORKBENCH_CLAUDE_CHROME=

# ## OpenClaw from a fork
# OpenClaw from your own fork instead of the pinned version: an npm package (.tgz — path or https://)
# and its sha256 (required). Ready packages: the fork's releases page (docs/openclaw-fork.md);
# or build one with tools/openclaw-fork-build.sh.
WORKBENCH_OPENCLAW_PACKAGE=
WORKBENCH_OPENCLAW_PACKAGE_SHA256=

# Presets of the OpenClaw fork (needs WORKBENCH_OPENCLAW_PACKAGE), comma-separated; set as env.vars
# settings, see docs/openclaw-fork.md. worker-limits — wider worker queues (OPENCLAW_WORKER_*):
# otherwise the memory index with transcripts of large chats fails with "worker task capacity reached".
# catalog-owner — user messages imported from the catalog are marked as the owner's
# (OPENCLAW_CATALOG_IMPORT_OWNER): without the mark Dreaming and session-backfill skip them.
WORKBENCH_FORK_PRESETS=

# ## Network and proxy
# Network proxy (docs/install/network.md). The URL may hold credentials: the installer never prints it.
# WORKBENCH_PROXY_URL — http(s) forward proxy for OpenClaw (proxy.proxyUrl). Empty: proxy config is not touched.
# WORKBENCH_PROXY_HOSTS — with the fork, host suffixes that go through it, everything else direct;
# empty, * or all — everything through the proxy (as with HTTPS_PROXY).
# WORKBENCH_PROXY_ROUTES — full form, wins over HOSTS: <hosts>=<proxy|direct|URL>;*=<proxy|direct|URL>
# (one proxy URL for OpenClaw's own traffic).
WORKBENCH_PROXY_URL=
WORKBENCH_PROXY_HOSTS=
WORKBENCH_PROXY_ROUTES=

# Claude Code's own proxy (~/.claude/settings.json env): a URL, or direct to remove what the installer wrote.
# Empty: not touched.
WORKBENCH_CLAUDE_CODE_PROXY=

# ## Claude Desktop chats, backups and files
# Claude Desktop chats by project: the folder where Claude Desktop kept project working folders
# (for example ~/claude-projects). The installer sets up a systemd user timer: every 10 minutes it builds
# the chat tree and imports new chats into project agents (migrate/claude-desktop/claude-code-catalog.mjs).
WORKBENCH_CLAUDE_DESKTOP_ROOT=

# Daily backup of the OpenClaw databases (shared state and every agent, with chat history and keys) into a
# local Git repository: a folder, e.g. ~/Backups/openclaw-git. The installer creates the repository and the
# Gateway-owned 24h schedule (the Gateway must be running), and takes a snapshot before replacing OpenClaw.
WORKBENCH_BACKUP=

# Chat attachments (tools/files-backup.sh): a local folder and an rclone remote of type crypt
# (for example gdrive-crypt: on top of Google Drive). Without a remote — local copy only.
WORKBENCH_FILES_DIR=
WORKBENCH_FILES_REMOTE=

# ## Claude CLI on a VM
# Claude CLI on a VM: user@host from ~/.ssh/config. The VM needs claude-agent-acp,
# acp-reaper (tools/remote-vm/acp-reaper) and the project at the same absolute path.
WORKBENCH_VM_SSH=

# ## Judge and evals
# Judge (judge skill of the ai-workbench plugin). Use a model from a DIFFERENT family than the one
# answering (Zheng et al., 2023); id as the provider names it. Without a model the judge writes "NOT EVALUATED".
# claude-cli/<id> (for example claude-cli/claude-haiku-5-5) — via the Claude CLI and subscription, no key.
WORKBENCH_JUDGE_MODEL=

# Defaults to OpenRouter and OPENROUTER_API_KEY; for Ollama — http://127.0.0.1:11434/v1.
WORKBENCH_JUDGE_BASE_URL=
WORKBENCH_JUDGE_API_KEY=

# Custom criteria: path to a JSON list of {"id","name","question"}.
WORKBENCH_JUDGE_CRITERIA=

# Proxy for the judge only — if the provider is not reachable directly (OpenRouter returns 403
# "Access denied by security policy", the Claude CLI returns 403 "Request not allowed" in some regions).
# The judge ignores the environment proxy.
WORKBENCH_JUDGE_PROXY=

# Eval executor not on Claude (tools/eval-executor/claude): the model is
# CLAUDE_EVAL_MODEL when starting the runner, or set here; URL, key and proxy work as for the judge.
WORKBENCH_EVAL_MODEL=
WORKBENCH_EVAL_BASE_URL=
WORKBENCH_EVAL_API_KEY=
WORKBENCH_EVAL_PROXY=
